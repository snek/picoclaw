# ============================================================
# Stage 1: Build the picoclaw binary
# ============================================================
FROM golang:1.26.1-alpine AS builder

RUN apk add --no-cache git make

WORKDIR /src

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build
COPY . .
RUN make build

# ============================================================
# Stage 2: Node.js-based runtime with full MCP support
# ============================================================
FROM node:24-alpine3.23

# Install runtime dependencies
RUN apk add --no-cache \
  ca-certificates \
  curl \
  git \
  python3 \
  py3-pip \
  inetutils-telnet \
  tini

# Install uv and ensure it's in the system path
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh && \
  uv --version

# Copy binary
COPY --from=builder /src/build/picoclaw /usr/local/bin/picoclaw

# Rename the 'node' user to 'picoclaw' for consistency
RUN deluser node && \
    addgroup -g 1000 picoclaw && \
    adduser -D -u 1000 -G picoclaw picoclaw

# Set up home directory and npm cache with correct permissions
RUN mkdir -p /home/picoclaw/.picoclaw /home/picoclaw/.npm && \
    chown -R picoclaw:picoclaw /home/picoclaw

# Switch to non-root user
USER picoclaw
WORKDIR /home/picoclaw

# Create picoclaw home directory structure
RUN /usr/local/bin/picoclaw onboard

ENTRYPOINT ["/sbin/tini", "-v", "--", "picoclaw"]
CMD ["gateway"]
